AZURE_ORGANIZATION_NAME=your-organization-name
AZURE_API_VERSION=6.0
AZURE_PAT=your-personal-access-token

APP_DEFAULT_PROJECT=temp-workitems
APP_LOG_PATH=./logs

# Local DevOps
LOCAL_DOCKER_LAMP_PATH=C:\path\to-project
LOCAL_WWW_PATH=C:\path\to-project\apache\www
LOCAL_VHOSTS_FILE=C:\path\to-project\apache\vhosts\ci-apps.conf
LOCAL_HOSTS_FILE=C:\Windows\System32\drivers\etc\hosts
LOCAL_BASE_ENV_FILE=C:\path\to-project\apache\www\app-plataformabase\html\.env

# Provision API
PROVISION_SALT=your-provision-salt
PROVISION_TIMEZONE=Europe/Berlin
PROVISION_DOMAIN_PRODUCTION=https://provision.example.com/
PROVISION_DOMAIN_DEVELOPMENT=https://provision-dev.example.com/
PROVISION_DOMAIN_LOCAL=http://host.docker.internal:3016/
PROVISION_ENVIRONMENT=development

# Microsoft Graph API - Outlook (delegated Mail.Read, device code flow, public client sin secret)
OUTLOOK_TENANT_ID=azure-tenant-id
OUTLOOK_CLIENT_ID=azure-app-client-id
OUTLOOK_DEFAULT_MAILBOX=your-email@example.com
OUTLOOK_DOWNLOADS_PATH=C:\path\to\downloads
OUTLOOK_ARCHIVE_PATH=C:\path\to\email-archives
