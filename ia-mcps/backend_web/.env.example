APP_ENV=local
APP_DEBUG=0

# Carpeta de logs. Vacío = backend_web/storage/logs.
APP_LOG_PATH=

# Borde de auth de /mcp/*: cabecera X-Api-Key. Vacía = nadie pasa.
# Es la misma clave que hay que pasarle a Claude Code al registrar cada server
# (`--header "X-Api-Key: ..."`), ver ia-mcps-deploy.md.
MCP_API_KEY=example-mcp-api-key

# emt_mod — EMT Madrid API (https://mobilitylabs.emtmadrid.es)
EMT_CLIENT_ID=your-emt-client-id
EMT_PASSKEY=your-emt-passkey

# Base de datos SQLite. Hoy NINGÚN módulo de este repo la usa (la abstracción se
# conserva para que portar un módulo con SQLite desde mcp-tools sea una copia).
# Vacío = backend_web/storage/sqlite/db_ia_mcps.sqlite
SQLITE_DB_PATH=

# media_mod — imagen (gpt-image / dall-e) y audio (TTS)
OPENAI_API_KEY=example-openai-api-key
MEDIA_OUTPUT_DIR=

# filechecker_mod — descargar la URL que pida el agente. En mcp-tools va APAGADO
# porque el proceso corre en el VPS (SSRF hacia otros contenedores o a los
# metadatos de Oracle); aquí el proceso es LOCAL y sale por tu propia red, que es
# el comportamiento que ia-mcps ha tenido siempre. 0 para apagarlo.
FILE_CHECKER_ALLOW_URL_DOWNLOAD=1

# memory_mod — `memory_store_file` lee la ruta que pida el agente y su contenido
# vuelve luego por `memory_search`. Mismo razonamiento que el de arriba: encendido
# porque el disco al que llega es el tuyo. 0 para apagarlo.
MEMORY_ALLOW_STORE_FILE=1

# memory_mod — memoria semántica. Vacío = backend_web/storage/cache/chroma y
# modelo local all-MiniLM-L6-v2 (sin llamadas a OpenAI).
# ⚠️ MIGRACIÓN: hasta ahora la memoria vivía en <raiz-del-repo>/data/chroma. O se
# mueve esa carpeta a backend_web/storage/cache/chroma, o se apunta aquí a la
# vieja. Si no se hace ninguna de las dos, Chroma crea una base VACÍA.
MEMORY_CHROMA_PATH=
MEMORY_EMBEDDING_MODEL=
