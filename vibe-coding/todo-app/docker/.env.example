# ===========================================================================
#  Variables de los COMPOSE de develop y de produccion
# ===========================================================================
#
# OJO: hay DOS ficheros `.env` en este proyecto y no son lo mismo.
#
#   docker/.env          <- este. Lo lee DOCKER COMPOSE para rellenar los
#                           ${MARCADORES} de docker-compose-develop.yml y
#                           docker-compose-prod.yml: nombres, dominio y rutas.
#
#   backend_web/.env        Lo lee la APLICACION al arrancar: la credencial de la
#                           API, la ruta de la base de datos, el entorno.
#
# Las de los dos ficheros empiezan por `APP_`: es la regla del proyecto.
#
# Copia este fichero a `docker/.env` y rellenalo:
#
#     cp docker/.env.example docker/.env
#
# `docker/.env` NO se sube a git. Este `.env.example` SI.
#
# Para desarrollo local (`make up`, `make dev`) NO hace falta nada de esto:
# docker-compose.yml no usa ninguna variable.


# Nombre del proyecto. Sale en el nombre de la imagen (`mi-poc:develop`), en el
# del contenedor (`cont-dev-mi-poc`) y en las etiquetas del proxy.
# Minusculas y guiones; nada de espacios ni de mayusculas.
APP_NAME=mi-poc

# Dominio publico por el que se entra. SIN https:// y SIN barra final.
#   develop -> develop-mi-poc.ejemplo.com
#   prod    -> mi-poc.ejemplo.com
APP_DOMAIN=develop-mi-poc.ejemplo.com

# Carpeta DEL SERVIDOR donde vive lo que tiene que sobrevivir a un
# redespliegue. Tiene que ser una ruta ABSOLUTA y tiene que EXISTIR antes de
# arrancar el contenedor.
#
# Dentro tiene que haber:
#     <APP_HOST_STORAGE_PATH>/.env        <- el .env de la APLICACION (copia de
#                                        backend_web/.env.example, relleno)
#     <APP_HOST_STORAGE_PATH>/storage/    <- carpeta vacia: ahi caeran la base de
#                                        datos y los logs
#
# Crearlo es:
#     sudo mkdir -p /ruta/que/elijas/storage
#     sudo cp backend_web/.env.example /ruta/que/elijas/.env
#     # y editar ese .env: sobre todo API_KEY y APP_ENV
#
# ⚠️ Si esto apunta a un sitio equivocado, el PoC arranca igual y PIERDES LOS
# DATOS en el siguiente despliegue, sin ningun aviso.
APP_HOST_STORAGE_PATH=/ruta/absoluta/en/el/servidor/mi-poc

# Red del proxy inverso que ya existe en el servidor. El compose NO la crea
# (esta declarada como `external`), asi que tiene que llamarse exactamente igual
# que la que hay montada. Comprobar con: docker network ls
APP_PROXY_NETWORK=web
