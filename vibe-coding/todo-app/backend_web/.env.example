# Copia este fichero a `.env` y rellena los valores.
#   cp backend_web/.env.example backend_web/.env
#
# `.env` NO se sube a git (esta en .gitignore). `.env.example` SI: es la lista de
# lo que hay que configurar. Cada vez que anadas una variable nueva al codigo,
# anadela aqui tambien, aunque sea vacia.

# local | develop | production. Lo devuelve /health-check, asi que sirve para
# saber contra que entorno estas hablando sin mirar la URL.
APP_ENV=local
APP_DEBUG=1

# Ruta del fichero SQLite, RELATIVA a backend_web/. Relativa a proposito: asi el
# mismo .env vale corriendo en el host y dentro del contenedor.
DB_PATH=storage/database/todo_app.db

# Carpeta de logs, tambien relativa a backend_web/.
APP_LOG_PATH=storage/logs

# Credencial de la API. Va en la cabecera X-Api-Key de toda peticion a /api/*.
# Si la dejas VACIA la API rechaza TODO con 401: un .env a medio rellenar no
# puede dejar la API abierta por accidente.
API_KEY=change-me-local-only

TIME_ZONE=UTC
