# Copia este fichero a `.env` y rellena los valores.
#   cp backend_web/.env.example backend_web/.env
#
# `.env` NO se sube a git (esta en .gitignore). `.env.example` SI: es la lista de
# lo que hay que configurar.
#
# ---------------------------------------------------------------------------
# TODAS LAS VARIABLES EMPIEZAN POR `APP_`. Sin excepcion.
#
# El proceso hereda las variables de la maquina, del contenedor y del sistema de
# despliegue, y ahi ya hay cientos con nombres genericos. Una variable tuya
# llamada `DB_PATH` o `API_KEY` puede chocar con la de otra cosa, y el fallo que
# sale de ahi es de los peores: no revienta, coge el valor equivocado.
#
# TODAS SON OPCIONALES menos la credencial. Al lado de cada una esta lo que vale
# si no la pones; los valores por defecto viven en el codigo, en
# `shared/domain/enums/env_default_enum.py`.
# ---------------------------------------------------------------------------

# Zona horaria. Las fechas se guardan en UTC, asi que esto casi nunca hace falta
# tocarlo.
#
# SI NO SE DEFINE: UTC
APP_TIME_ZONE=UTC

# Los TRES entornos del proyecto, y se escriben asi de largo en todas partes:
#
#     local | develop | production
#
# Nada de `dev` ni de `prod`: si escribes la abreviatura, la aplicacion no
# reconoce el entorno y se comporta como si fuera otro.
#
# SI NO SE DEFINE: production.
#
# Es lo contrario de lo comodo, y es a proposito. El olvido tipico es desplegar
# sin APP_ENV; si el valor por defecto fuera `local`, ese olvido abriria la
# depuracion en un servidor publico y nadie se enteraria. Con este, el olvido
# solo hace que veas menos informacion de la que querias.
#
# Lo devuelve /health-check, asi que sirve para saber contra que entorno estas
# hablando sin mirar la URL.
APP_ENV=local

# Modo depuracion. OJO: el ENTORNO manda sobre esta variable.
#
#     production   NUNCA hay debug. Da igual lo que pongas aqui.
#     develop      apagado por defecto; se enciende con APP_DEBUG=1.
#     local        encendido por defecto; se apaga con APP_DEBUG=0.
#
# Lo que cambia entre local y develop es el valor POR DEFECTO cuando la variable
# no esta definida. Si la defines, en los dos se respeta lo que digas.
#
# SI NO SE DEFINE: 0 (salvo en local, donde viene encendida).
APP_DEBUG=1

# ---------------------------------------------------------------------------
# RUTAS Y CREDENCIAL
# ---------------------------------------------------------------------------

# Carpeta de logs, tambien relativa a backend_web/.
#
# SI NO SE DEFINE: storage/logs
APP_LOG_PATH=storage/logs

# Ruta del fichero SQLite, RELATIVA a backend_web/. Relativa a proposito: asi el
# mismo .env vale corriendo en el host y dentro del contenedor.
#
# SI NO SE DEFINE: storage/database/todo_app.db
APP_DB_PATH=storage/database/todo_app.db

# Credencial de la API. Va en la cabecera X-Api-Key de toda peticion a /api/*.
#
# El valor de abajo es un MARCADOR y lo dice su propio nombre: sirve para
# trastear en local y NO vale para nada mas. La fecha del final esta ahi para
# que se vea de un vistazo si lleva sin tocar desde que se copio la plantilla.
#
# ANTES DE DESPLEGAR, genera una de verdad:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SI NO SE DEFINE: vacia, y entonces la API rechaza TODO con 401. Un .env a
# medio rellenar no puede dejar la API abierta por accidente.
APP_API_KEY=change-this-in-production-20260901
